		"overrides": {
			"@types/react": "$@types/react",
			"@types/react-dom": "$@types/react-dom",
			"detect-libc@^1.0.3": "^2.0.3",
			"glob-parent@^5.1.2": "^6.0.2",
			"postcss": "$postcss",
			"postcss-import": "$postcss-import",
			"react-dom": "$react-dom",
			"react": "$react",
			"chokidar@^3.6.0": "^4.0.1"
		}
