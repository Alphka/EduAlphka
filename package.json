	},
	"devDependencies": {
		"@types/lodash": "~4.17.13",
		"@types/node": "^22.10.2",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"cross-env": "~7.0.3",
		"dotenv": "~16.4.7",
		"ts-node": "~10.9.2",
		"tsconfig-paths": "~4.2.0"
	},
	"dependencies": {
		"@mantine/core": "~7.15.1",
		"@mantine/dates": "~7.15.1",
		"@mantine/hooks": "~7.15.1",
		"autoprefixer": "~10.4.20",
		"lodash": "~4.17.21",
		"mongoose": "~8.9.2",
		"next": "15.1.2",
		"postcss": "^8.4.49",
		"postcss-import": "~16.1.0",
		"postcss-preset-mantine": "~1.17.0",
