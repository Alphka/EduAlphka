{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2021",
		"moduleResolution": "Bundler",
		"strict": true,
		"checkJs": true,
		"allowJs": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"resolveJsonModule": true,
		"noUnusedParameters": true,
		"allowUnusedLabels": false,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noUnusedLocals": true,
		"skipLibCheck": false,
		"incremental": true,
		"sourceMap": true,
		"jsx": "preserve",
		"plugins": [
			{ "name": "next" }
		],
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ESNext"
		],
		"typeRoots": [
			"node_modules/@types",
			"./src/typings"
		],
		"paths": {
			"@components/*": ["./src/app/components/*"],
			"@constants": ["./src/app/constants/index.ts"],
			"@constants/*": ["./src/app/constants/*"],
			"@schemas/*": ["./src/app/schemas/*"],
			"@contexts/*": ["./src/app/contexts/*"],
			"@images/*": ["./src/app/images/*"],
			"@hooks/*": ["./src/app/hooks/*"],
			"@helpers/*": ["./src/helpers/*"],
			"@typings": ["./src/typings/index.d.ts"],
			"@typings/*": ["./src/typings/*"],
			"@models": ["./src/models/index.ts"],
			"@models/*": ["./src/models/*"],
			"@lib/*": ["./src/lib/*"],
			"@app/*": ["./src/app/*"],
			"@src/*": ["./src/*"],
			"@root/*": ["./*"]
		},
		"noEmit": true
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"next.config.ts",
		".next/types/**/*.ts"
	],
	"exclude": [
		"node_modules"
	],
	"typeAcquisition": {
		"enable": true
	}
}
